# Copiá este archivo como .env y completá los valores. El .env NO se versiona.
#
# Forma de la dirección de la base (driver asincrónico postgresql+asyncpg):
#   postgresql+asyncpg://<usuario>:<contraseña>@<servidor>:<puerto>/<base>
#
# En la máquina del grupo el servidor suele ser localhost.
# Dentro de un contenedor, localhost es el propio contenedor: si la base corre
# en el servidor, usá host.docker.internal (con --add-host=host.docker.internal:host-gateway)
# o la dirección que entregue la cátedra.
DATABASE_URL=postgresql+asyncpg://<usuario>:<contraseña>@<servidor>:5432/<base>

# true escribe en la consola cada consulta SQL que se emite (diagnóstico, caso C-07).
# En el VPS va en false.
SQL_ECHO=false

# Sólo para las pruebas automáticas (pytest): una base de PRUEBA, distinta de la
# de trabajo, porque las pruebas vacían las tablas.
# TEST_DATABASE_URL=postgresql+asyncpg://<usuario>:<contraseña>@localhost:5432/<base_de_prueba>
